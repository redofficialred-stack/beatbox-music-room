            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('3 instruments', () => pm.expect(r).to.have.lengthOf(3));",
              "pm.test('Highest count first', () => pm.expect(r[0].loan_count).to.be.at.least(r[1].loan_count));",
